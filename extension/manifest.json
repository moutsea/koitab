{
  "manifest_version": 3,
  "name": "KoiTab - 标签页整理助手",
  "short_name": "KoiTab",
  "version": "5.1.1",
  "description": "一键整理浏览器标签页:合并同类网站、关闭重复网页,让标签栏井井有条。",
  "permissions": [
    "tabs",
    "tabGroups",
    "bookmarks",
    "storage"
  ],
  "action": {
    "default_title": "KoiTab - 整理标签页",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "121"
}
